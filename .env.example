# Copy to .env.local and fill in. These values are baked in at build time.

# Where the contact and catering forms POST their data (JSON). Example: a Formspree form URL.
# Leave empty to fall back to opening the visitor's email app with the message pre-filled.
FORM_ENDPOINT=

# Public site URL used for canonical links, Open Graph, sitemap.xml and JSON-LD.
SITE_URL=https://afwajhgroup.com

# Google Search Console "HTML tag" verification code (just the content="..." value).
GOOGLE_SITE_VERIFICATION=
